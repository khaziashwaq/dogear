# ─── dogear. environment ──────────────────────────────────────────────
# Leave the Supabase values empty to run in DEMO MODE: a local, file-backed
# store seeded with sample readers (clearly labelled in the UI).

# Public site URL (used for OAuth redirects and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API). The anon key is safe in the browser;
# Row Level Security enforces every permission.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" once Google is enabled under Authentication → Providers.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Never put a service-role key here or in any NEXT_PUBLIC_* variable.
