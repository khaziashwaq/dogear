# ─── dogear. environment ──────────────────────────────────────────────
# Leave the Supabase values empty to run in DEMO MODE (development only): a local, file-backed
# store seeded with sample readers (clearly labelled in the UI).

# Public site URL (used for OAuth redirects and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API). The anon key is safe in the browser;
# Row Level Security enforces every permission.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" once Google is enabled under Authentication → Providers.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Server-only (never NEXT_PUBLIC_*): Project Settings → API → service_role / secret key.
# Used for exactly two things readers must not do themselves: adding books to the shared
# catalogue and deleting an account. A production server refuses to start without it.
SUPABASE_SERVICE_ROLE_KEY=

# Leaving the Supabase values empty runs local sample-data mode, in development only.
